# Arena worker override
PROCESS_ROLE=arena-worker
MYSQL_CONNECTION_LIMIT=1
MYSQL_LOCK_WAIT_TIMEOUT_SECONDS=5

# 관리자 스냅샷/리플레이 정리 작업은 API가 등록하고 arena-worker가 순차 처리합니다.
ARENA_WORKER_JOB_POLL_INTERVAL_MS=30000
ARENA_WORKER_STALE_JOB_RESET_INTERVAL_MS=300000
ARENA_WORKER_STALE_JOB_MINUTES=30
ARENA_WORKER_HEARTBEAT_INTERVAL_MS=60000

# 빠른대전/8인 컵 큐 만료 및 중단 상태를 낮은 주기로 정리합니다.
ARENA_WORKER_AUTO_QUEUE_RECOVERY=true
ARENA_WORKER_QUEUE_RECOVERY_INTERVAL_MS=60000
ARENA_WORKER_ROUND_RECOVERY_INTERVAL_MS=30000
ARENA_EXPIRED_ROUND_SCAN_LIMIT=10
