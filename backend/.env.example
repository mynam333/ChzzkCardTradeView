# Chikapo backend common environment
#
# 모든 백엔드 프로세스가 이 파일을 먼저 읽습니다.
# 이후 backend/.env.<PROCESS_ROLE> 파일이 있으면 같은 키를 override합니다.
# 운영 권장 PROCESS_ROLE: api, live-worker, scheduler-worker, backup-worker, image-worker, chat-worker

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=production
PROCESS_ROLE=api
PORT=2083
USE_HTTPS=true

# 요청/런타임 로그
BACKEND_FILE_LOGGING=true
LOG_DIR=./backend/logs
LOG_RETENTION_DAYS=14
LOG_MAX_STRING_LENGTH=2000
LOG_FILE_PREFIX=backend
LOG_SPLIT_BY_PROCESS=true
LOG_PRUNE_INTERVAL_MS=21600000
RUNTIME_STATS_LOGGING=true
RUNTIME_STATS_LOG_INTERVAL_MS=60000
SLOW_REQUEST_LOG_MS=2000
IMAGE_PROXY_SLOW_REQUEST_LOG_MS=3000
REQUEST_LOG_URL_MAX_LENGTH=300

# -----------------------------------------------------------------------------
# Public URLs / CORS
# -----------------------------------------------------------------------------
BACKEND_PUBLIC_URL=https://api.yuaru.com
CORS_ALLOWED_ORIGINS=https://chikapo.yuaru.com,https://dev.chikapo.yuaru.com
PUSH_ALLOWED_ORIGINS=https://chikapo.yuaru.com,https://dev.chikapo.yuaru.com

# 프론트가 직접 Supabase에 연결하지 않는 구조입니다.
# NEXT_PUBLIC_SUPABASE_* 계열은 프론트/백엔드 env에 넣지 마세요.

# -----------------------------------------------------------------------------
# HTTPS certificate
# -----------------------------------------------------------------------------
# Cloudflare Origin Certificate 권장
CLOUDFLARE_ORIGIN_KEY_PATH=backend/yuaru.com/yuaru.com.key
CLOUDFLARE_ORIGIN_CERT_PATH=backend/yuaru.com/yuaru.com.pem

# 일반 인증서 파일을 쓸 때만 사용
# SSL_KEY_PATH=/etc/ssl/private/origin.key
# SSL_CERT_PATH=/etc/ssl/certs/origin.pem
# SSL_PRIVKEY_PATH=/etc/letsencrypt/live/chikapo.yuaru.com/privkey.pem
# SSL_FULLCHAIN_PATH=/etc/letsencrypt/live/chikapo.yuaru.com/fullchain.pem

# -----------------------------------------------------------------------------
# Security / auth
# -----------------------------------------------------------------------------
# 필수. 운영에서는 반드시 긴 랜덤값으로 교체하세요.
# 예: openssl rand -hex 32
JWT_SECRET=please_change_me_to_a_long_random_secret

# 선택. 없으면 JWT_SECRET에서 파생됩니다.
# TOKEN_ENCRYPTION_KEY=another_long_random_secret

AUTH_USER_CACHE_TTL_MS=15000
AUTH_USER_LOOKUP_TIMEOUT_MS=3000

API_ACCESS_GUARD_ENABLED=true
SOFT_BAN_ENABLED=true
SOFT_BAN_WINDOW_MS=60000
SOFT_BAN_DURATION_MS=60000
SOFT_BAN_MAX_SCORE=3000
SOFT_BAN_MAX_REQUESTS=3000
SOFT_BAN_MAX_MUTATIONS=300
SOFT_BAN_MAX_PUSH_SUBSCRIBES=30
SOFT_BAN_MAX_IMAGE_PROXY=1000

# SSE 최대 연결 수
MAX_REALTIME_CLIENTS=2000
MAX_NOTIFICATION_CLIENTS=2000

# 친구 1:1 톡 WebSocket 워커
# Nginx/Cloudflare에서는 /chat 요청을 CHAT_WORKER_PORT로 프록시하세요.
CHAT_WORKER_PORT=5001
CHAT_WS_PATH=/chat
CHAT_WS_HEARTBEAT_MS=30000

# -----------------------------------------------------------------------------
# Database mode
# -----------------------------------------------------------------------------
# 운영 기본은 MySQL입니다. 허용값: mysql, sqlite, supabase
DB_MODE=mysql

# MySQL 접속 정보. MYSQL_URL 하나 또는 개별 값 중 하나를 사용하세요.
# MYSQL_URL=mysql://chikapo:change_me@127.0.0.1:3306/chzzk_card_trade_view
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=chikapo
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=chikapo
MYSQL_CONNECTION_LIMIT=10
MYSQL_QUEUE_LIMIT=0
MYSQL_LOCK_WAIT_TIMEOUT_SECONDS=5
MYSQL_TRANSACTION_MAX_ATTEMPTS=3

# MySQL SSL이 필요할 때만 사용
# MYSQL_SSL=true
# MYSQL_SSL_CA_PATH=./certs/mysql-ca.pem

# SQLite fallback/로컬 운영용. DB_MODE=sqlite일 때 사용합니다.
SQLITE_DB_PATH=./local.sqlite
SQLITE_REQUIRE_PERSISTENT_PATH=false

# Supabase는 현재 운영 기본값이 아닙니다. DB_MODE=supabase일 때만 설정하세요.
# SUPABASE_URL=https://your-supabase-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_or_legacy_service_role_key_here
# SUPABASE_FETCH_TIMEOUT_MS=15000

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
UPLOADS_DIR=./public/uploads

# -----------------------------------------------------------------------------
# Chzzk OAuth / OpenAPI
# -----------------------------------------------------------------------------
CHZZK_CLIENT_ID=your_chzzk_client_id
CHZZK_CLIENT_SECRET=your_chzzk_client_secret
CHZZK_API_URL=https://api.chzzk.naver.com

# -----------------------------------------------------------------------------
# Web push
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@yuaru.com
PUSH_SEND_BATCH_SIZE=25
PUSH_SEND_BATCH_DELAY_MS=200

# -----------------------------------------------------------------------------
# Process-role controls
# -----------------------------------------------------------------------------
# API 프로세스에서는 이미지 프록시를 끄고 image-worker로 라우팅하는 것을 권장합니다.
API_SERVE_IMAGE_PROXY=false

# api 역할에서는 기본적으로 false입니다. scheduler-worker에서 true로 override하세요.
RUN_PUSH_SCHEDULER=false
RUN_MARKET_SCHEDULER=false

# -----------------------------------------------------------------------------
# Live status / external chat counter
# -----------------------------------------------------------------------------
CHAT_COUNT_FLUSH_INTERVAL_MS=10000
CHAT_COUNT_FLUSH_WARN_THRESHOLD=10000
CHAT_CONNECT_TIMEOUT_MS=5000
CHAT_CONNECT_BACKOFF_BASE_MS=300000
CHAT_CONNECT_BACKOFF_MAX_MS=1800000
MYSQL_CHAT_FLUSH_CHUNK_SIZE=50

VALUE_HISTORY_RECORD_EVERY_CYCLES=3
VALUE_HISTORY_MIN_PCT_DELTA=0.005
VALUE_HISTORY_INSERT_CHUNK_SIZE=100
VALUE_HISTORY_INSERT_CHUNK_DELAY_MS=30
VALUE_AGO_CACHE_TTL_MS=60000
VALUE_AGO_LOOKBACK_HOURS=3

# -----------------------------------------------------------------------------
# Market / ranking / profile cache
# -----------------------------------------------------------------------------
MARKET_LIST_CACHE_TTL_MS=5000
MARKET_SETTLE_MIN_INTERVAL_MS=15000
STREAMER_RANKING_MAX_LIMIT=10000
PROFILE_SYNC_THROTTLE_MS=600000
PROFILE_SYNC_CACHE_RETENTION_MS=86400000
DRAW_POOL_CACHE_TTL_MS=60000
SYSTEM_CONFIG_CACHE_TTL_MS=30000

# -----------------------------------------------------------------------------
# Image proxy worker
# -----------------------------------------------------------------------------
IMAGE_WORKER_PORT=2087
IMAGE_PROXY_TIMEOUT_MS=3000
IMAGE_PROXY_CACHE_TTL_MS=86400000
IMAGE_PROXY_NEGATIVE_CACHE_TTL_MS=300000
IMAGE_PROXY_MAX_BYTES=4194304
IMAGE_PROXY_MAX_CACHE_BYTES=134217728
IMAGE_PROXY_MAX_CACHE_ENTRIES=500
IMAGE_PROXY_MAX_RESIZE_WIDTH=768
IMAGE_PROXY_PSTATIC_TYPES=f60_60_na,f120_120_na,f240_240_na

# -----------------------------------------------------------------------------
# MySQL -> SQLite backup worker
# -----------------------------------------------------------------------------
MYSQL_SQLITE_BACKUP_ENABLED=true
MYSQL_SQLITE_BACKUP_DIR=./backups/mysql-sqlite
MYSQL_SQLITE_BACKUP_RETENTION_DAYS=7
MYSQL_SQLITE_BACKUP_CRON=*/30 * * * *
MYSQL_SQLITE_BACKUP_BATCH_SIZE=500
MYSQL_SQLITE_BACKUP_MIN_UPTIME_SECONDS=300
MYSQL_SQLITE_BACKUP_MAX_RSS_MB=700
MYSQL_SQLITE_BACKUP_MAX_HEAP_USED_MB=450
MYSQL_SQLITE_BACKUP_MAX_REALTIME_CLIENTS=20
MYSQL_SQLITE_BACKUP_MAX_NOTIFICATION_CLIENTS=20
MYSQL_SQLITE_BACKUP_MAX_CHAT_CONNECTIONS=10
MYSQL_SQLITE_BACKUP_MAX_DESIRED_CHAT_CONNECTIONS=10
MYSQL_SQLITE_BACKUP_MAX_CHAT_PENDING=200
MYSQL_SQLITE_BACKUP_MAX_RECONNECT_TIMERS=30
