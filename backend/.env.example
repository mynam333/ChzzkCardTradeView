# CCTV 백엔드 서버 환경 변수 예시 설정

# 서버 포트
PORT=5000

# 치지직 인증 세션 발급용 JWT 비밀키
JWT_SECRET=chzzk_card_trade_secret_2026_key

# Supabase 클라우드 데이터베이스 연동 정보
# 이 값이 누락되거나 접속 실패 시 백엔드는 자동으로 로컬 SQLite3 (local.sqlite) 모드로 가동됩니다.
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service-role-key-here...

# PWA 웹 푸시 알림 VAPID 암호키 쌍
# web-push 라이브러리를 통해 생성된 공개키/비공개키를 입력합니다.
VAPID_PUBLIC_KEY=BHw-your-vapid-public-key-goes-here...
VAPID_PRIVATE_KEY=your-vapid-private-key-goes-here...

# 치지직 네이버 로그인 API 인증 클라이언트 정보
CHZZK_CLIENT_ID=your_chzzk_client_id
CHZZK_CLIENT_SECRET=your_chzzk_client_secret
CHZZK_API_URL=https://api.chzzk.naver.com

