# 치카포 백엔드 서버 환경 변수 예시 설정

# 서버 포트
PORT=5000

# 실행 환경 (production 으로 설정 시 에러 응답에서 내부 상세 메시지를 숨깁니다)
NODE_ENV=development

# 치지직 인증 세션 발급용 JWT 비밀키 (필수: 미설정 시 서버가 기동되지 않습니다)
# 충분히 길고 무작위한 값으로 교체하세요. 예) openssl rand -hex 32
JWT_SECRET=please_change_me_to_a_long_random_secret

# OAuth 토큰 암호화 키 (선택: 미설정 시 JWT_SECRET에서 파생됩니다)
# TOKEN_ENCRYPTION_KEY=another_long_random_secret

# CORS 허용 오리진 (콤마 구분, 미설정 시 localhost:3000 만 허용)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# 업로드 이미지 등 정적 파일 절대 URL 생성을 위한 백엔드 공개 주소 (예: https://api.example.com)
# 미설정 시 요청 헤더(protocol+host)로 자동 추론합니다.
BACKEND_PUBLIC_URL=http://localhost:5000

# SQLite 운영 모드
# Supabase 대신 persistent disk 기반 SQLite로 운영하려면 SUPABASE_* 값을 비우거나 제거하고,
# SQLITE_DB_PATH를 배포 플랫폼의 persistent volume 내부 경로로 설정하세요.
# 예: Render Disk /var/data/chikapo.sqlite, Fly Volume /data/chikapo.sqlite
# SQLITE_REQUIRE_PERSISTENT_PATH=true이면 SQLITE_DB_PATH 누락 시 서버 시작을 중단합니다.
SQLITE_DB_PATH=./local.sqlite
SQLITE_REQUIRE_PERSISTENT_PATH=false
# 커스텀 카드 이미지도 재배포 후 보존하려면 persistent volume 내부 경로를 사용하세요.
UPLOADS_DIR=./public/uploads

# Supabase 클라우드 데이터베이스 연동 정보
# SUPABASE_REQUIRED=false이면 아래 값이 남아 있어도 연결 검사를 건너뛰고 SQLite 모드로 바로 가동됩니다.
SUPABASE_URL=https://your-supabase-project.supabase.co
# 반드시 서버 전용 secret/service_role key를 사용하세요. sb_publishable_* 또는 anon key는 사용 금지.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_or_legacy_service_role_key_here
# Supabase 운영에서는 true 권장. SQLite 운영에서는 false 또는 미설정으로 둡니다.
SUPABASE_REQUIRED=false

# Supabase HTTP 호출이 오래 붙잡혀 서버 시작/요청 처리를 막지 않도록 하는 타임아웃
SUPABASE_FETCH_TIMEOUT_MS=15000

# Supabase PostgreSQL 직접 연결 (Transaction Pooler)
DATABASE_URL=...

# PWA 웹 푸시 알림 VAPID 암호키 쌍
# web-push 라이브러리를 통해 생성된 공개키/비공개키를 입력합니다.
VAPID_PUBLIC_KEY=BHw-your-vapid-public-key-goes-here...
VAPID_PRIVATE_KEY=your-vapid-private-key-goes-here...
VAPID_SUBJECT=mailto:admin@yuaru.com

# 치지직 네이버 로그인 API 인증 클라이언트 정보
CHZZK_CLIENT_ID=your_chzzk_client_id
CHZZK_CLIENT_SECRET=your_chzzk_client_secret
CHZZK_API_URL=https://api.chzzk.naver.com

# HTTPS SSL 보안 인증서 설정 (선택 사항)
# USE_HTTPS를 true로 설정 시 지정한 경로의 SSL 키/인증서 파일을 읽어 HTTPS 프로토콜로 작동합니다.
USE_HTTPS=false
# Cloudflare Origin Certificate 사용 시: Cloudflare 대시보드에서 받은 private key(.key)와 certificate(.pem)
CLOUDFLARE_ORIGIN_KEY_PATH=/etc/ssl/cloudflare/origin.key
CLOUDFLARE_ORIGIN_CERT_PATH=/etc/ssl/cloudflare/origin.pem
# 일반 인증서 파일명 사용 시
# SSL_KEY_PATH=/etc/ssl/private/origin.key
# SSL_CERT_PATH=/etc/ssl/certs/origin.pem
# Let's Encrypt 호환 레거시 변수명도 계속 지원합니다.
SSL_PRIVKEY_PATH=/etc/letsencrypt/live/yourdomain.com/privkey.pem
SSL_FULLCHAIN_PATH=/etc/letsencrypt/live/yourdomain.com/fullchain.pem

# 푸시 구독을 허용할 프론트엔드 오리진 목록 (콤마 구분)
PUSH_ALLOWED_ORIGINS=http://localhost:5000

# 과도 요청 임시 제한(soft-ban). 정상 사용자는 기본값으로 충분히 여유가 있습니다.
API_ACCESS_GUARD_ENABLED=true
SOFT_BAN_ENABLED=true
SOFT_BAN_WINDOW_MS=60000
SOFT_BAN_DURATION_MS=300000
SOFT_BAN_MAX_SCORE=240
SOFT_BAN_MAX_REQUESTS=180
SOFT_BAN_MAX_MUTATIONS=60
SOFT_BAN_MAX_PUSH_SUBSCRIBES=6

# 인증 사용자 조회 캐시/타임아웃. DB 지연 시 요청이 오래 물리는 것을 방지합니다.
AUTH_USER_CACHE_TTL_MS=15000
AUTH_USER_LOOKUP_TIMEOUT_MS=3000

# LiveStatusScheduler 시세 이력 쓰기 부하 조정
CHAT_COUNT_INCREMENT_CHUNK_SIZE=200
CHAT_COUNT_FLUSH_WARN_THRESHOLD=10000
VALUE_HISTORY_RECORD_EVERY_CYCLES=3
VALUE_HISTORY_INSERT_CHUNK_SIZE=100
VALUE_HISTORY_INSERT_CHUNK_DELAY_MS=30
