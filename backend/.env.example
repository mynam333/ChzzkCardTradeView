# Chikapo backend common environment
#
# 모든 백엔드 프로세스가 이 파일을 먼저 읽습니다.
# 이후 backend/.env.<PROCESS_ROLE> 파일이 있으면 같은 키를 override합니다.
# 운영 권장 PROCESS_ROLE: api, live-worker, scheduler-worker, backup-worker, image-worker, chat-worker

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=production
PROCESS_ROLE=api
PORT=2083
USE_HTTPS=true

# 요청/런타임 로그
BACKEND_FILE_LOGGING=true
LOG_DIR=./backend/logs
LOG_RETENTION_DAYS=14
LOG_MAX_STRING_LENGTH=2000
LOG_MAX_BUFFER_BYTES=1048576
LOG_FILE_PREFIX=backend
LOG_SPLIT_BY_PROCESS=true
LOG_PRUNE_INTERVAL_MS=21600000
RUNTIME_STATS_LOGGING=true
RUNTIME_STATS_LOG_INTERVAL_MS=300000
SLOW_REQUEST_LOG_MS=2000
IMAGE_PROXY_SLOW_REQUEST_LOG_MS=3000
REQUEST_LOG_URL_MAX_LENGTH=300

# -----------------------------------------------------------------------------
# Public URLs / CORS
# -----------------------------------------------------------------------------
BACKEND_PUBLIC_URL=https://api.yuaru.com
CORS_ALLOWED_ORIGINS=https://chikapo.yuaru.com,https://dev.chikapo.yuaru.com
PUSH_ALLOWED_ORIGINS=https://chikapo.yuaru.com,https://dev.chikapo.yuaru.com

# 프론트가 직접 Supabase에 연결하지 않는 구조입니다.
# NEXT_PUBLIC_SUPABASE_* 계열은 프론트/백엔드 env에 넣지 마세요.

# -----------------------------------------------------------------------------
# HTTPS certificate
# -----------------------------------------------------------------------------
# Cloudflare Origin Certificate 권장
CLOUDFLARE_ORIGIN_KEY_PATH=backend/yuaru.com/yuaru.com.key
CLOUDFLARE_ORIGIN_CERT_PATH=backend/yuaru.com/yuaru.com.pem

# 일반 인증서 파일을 쓸 때만 사용
# SSL_KEY_PATH=/etc/ssl/private/origin.key
# SSL_CERT_PATH=/etc/ssl/certs/origin.pem
# SSL_PRIVKEY_PATH=/etc/letsencrypt/live/chikapo.yuaru.com/privkey.pem
# SSL_FULLCHAIN_PATH=/etc/letsencrypt/live/chikapo.yuaru.com/fullchain.pem

# -----------------------------------------------------------------------------
# Security / auth
# -----------------------------------------------------------------------------
# 필수. 운영에서는 반드시 긴 랜덤값으로 교체하세요.
# 예: openssl rand -hex 32
JWT_SECRET=please_change_me_to_a_long_random_secret

# 선택. 없으면 JWT_SECRET에서 파생됩니다.
# TOKEN_ENCRYPTION_KEY=another_long_random_secret

AUTH_USER_CACHE_TTL_MS=15000
AUTH_USER_CACHE_MAX_ENTRIES=5000
AUTH_USER_LOOKUP_TIMEOUT_MS=3000
LAST_SEEN_TOUCH_INTERVAL_MS=600000
LAST_SEEN_TOUCH_MAX_ENTRIES=10000
LAST_SEEN_TOUCH_RETENTION_MS=86400000

API_ACCESS_GUARD_ENABLED=true
SOFT_BAN_ENABLED=true
SOFT_BAN_WINDOW_MS=60000
SOFT_BAN_DURATION_MS=60000
SOFT_BAN_MAX_SCORE=10000
SOFT_BAN_MAX_REQUESTS=10000
SOFT_BAN_MAX_MUTATIONS=1000
SOFT_BAN_MAX_PUSH_SUBSCRIBES=120
SOFT_BAN_MAX_IMAGE_PROXY=5000

# 사용자별 개인 이미지 블라인드 최대 저장 개수
USER_IMAGE_BLIND_MAX_PER_USER=500

# API payload / rate limits
# *_RATE_LIMIT_MAX=0 으로 두면 해당 레이트 리밋을 비활성화합니다.
API_BODY_SIZE_LIMIT=2mb
RATE_LIMIT_MAX_BUCKETS=50000
GLOBAL_API_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_API_RATE_LIMIT_MAX=600
ROUTE_RATE_LIMIT_WINDOW_MS=60000
DRAW_RATE_LIMIT_MAX=180
SEARCH_RATE_LIMIT_MAX=180
TRADE_RATE_LIMIT_MAX=180
COUPON_RATE_LIMIT_MAX=60
AUTH_RATE_LIMIT_MAX=60
REGISTER_RATE_LIMIT_MAX=60
REPORT_RATE_LIMIT_MAX=60
CHAT_IMAGE_RATE_LIMIT_MAX=60
STREAMER_READ_RATE_LIMIT_MAX=240

# SSE 최대 연결 수
MAX_REALTIME_CLIENTS=5000
MAX_NOTIFICATION_CLIENTS=5000
ARENA_SSE_HEARTBEAT_INTERVAL_MS=25000
ARENA_QUICK_SSE_VERIFY_INTERVAL_MS=60000
ARENA_CUP_SSE_VERIFY_INTERVAL_MS=90000

# 친구 1:1 톡 WebSocket 워커
# Nginx/Cloudflare에서는 /chat 요청을 CHAT_WORKER_PORT로 프록시하세요.
CHAT_WORKER_PORT=5001
CHAT_WS_PATH=/chat
CHAT_WS_HEARTBEAT_MS=30000
# 소켓 워커 전체/사용자별 연결 수와 한 소켓에서 동시에 처리할 메시지 수의 하드 상한입니다.
CHAT_WS_MAX_CONNECTIONS=5000
CHAT_WS_MAX_CONNECTIONS_PER_USER=5
CHAT_WS_MAX_IN_FLIGHT_MESSAGES=4
# 단일 WebSocket 프레임 최대 크기(1KiB~64KiB 하드 제한, 기본 16KiB)
CHAT_WS_MAX_PAYLOAD_BYTES=16384
# 빠르게 끝나는 연속 요청도 제한합니다. 소켓과 사용자(여러 탭 합산) 버킷을 모두 통과해야 합니다.
CHAT_WS_SOCKET_MESSAGE_RATE_PER_SECOND=10
CHAT_WS_SOCKET_MESSAGE_BURST=20
CHAT_WS_USER_MESSAGE_RATE_PER_SECOND=50
CHAT_WS_USER_MESSAGE_BURST=100
# 재연결로 사용자 버킷을 초기화하지 못하도록 잠시 보존하되, 추적 엔트리는 하드 상한으로 제한합니다.
CHAT_WS_USER_BUCKET_TTL_MS=60000
CHAT_WS_MAX_TRACKED_USER_BUCKETS=20000
# 앱 ping은 비즈니스 요청과 분리하되 별도 소형 버킷으로 제한합니다.
CHAT_WS_PING_RATE_PER_SECOND=2
CHAT_WS_PING_BURST=4
# WebSocket protocol PING/PONG control frame은 자동 응답 대신 공용 소형 버킷으로 제한합니다.
CHAT_WS_CONTROL_FRAME_RATE_PER_SECOND=2
CHAT_WS_CONTROL_FRAME_BURST=8
# 느린 클라이언트로 누적되는 서버 송신 큐의 소켓별 상한(1KiB~16MiB, 기본 1MiB)
CHAT_WS_MAX_BUFFERED_BYTES=1048576
MAX_NOTIFICATION_CLIENTS_PER_USER=3
NOTIFICATION_SESSION_REVALIDATE_MS=25000
NOTIFICATION_SESSION_REVALIDATE_TIMEOUT_MS=3000
MAX_NOTIFICATION_BUFFERED_BYTES=262144
# JWT 및 현재 사용자/밴/역할 재검증 DB 조회의 최대 대기 시간입니다.
CHAT_WS_AUTH_REVALIDATE_TIMEOUT_MS=3000
# 링크 프리뷰는 메시지 저장과 분리된 선택 작업이며, 초과·만료 작업은 버립니다.
LINK_PREVIEW_CONCURRENCY=2
LINK_PREVIEW_QUEUE_MAX_PENDING=500
LINK_PREVIEW_QUEUE_MAX_PENDING_PER_SENDER=10
LINK_PREVIEW_QUEUE_JOB_TTL_MS=60000

# -----------------------------------------------------------------------------
# Database mode
# -----------------------------------------------------------------------------
# 운영 기본은 MySQL입니다. 허용값: mysql, postgres, sqlite, supabase
DB_MODE=mysql

# MySQL 접속 정보. MYSQL_URL 하나 또는 개별 값 중 하나를 사용하세요.
# MYSQL_URL=mysql://chikapo:change_me@127.0.0.1:3306/chzzk_card_trade_view
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=chikapo
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=chikapo
MYSQL_CONNECTION_LIMIT=5
MYSQL_QUEUE_LIMIT=0
MYSQL_LOCK_WAIT_TIMEOUT_SECONDS=5
MYSQL_TRANSACTION_MAX_ATTEMPTS=3
# 이 시간보다 오래 걸린 MySQL 쿼리는 [MySQLSlowQuery] 로그와 /health runtime.db.mysql에 기록합니다.
MYSQL_SLOW_QUERY_LOG_MS=1000

# MySQL SSL이 필요할 때만 사용
# MYSQL_SSL=true
# MYSQL_SSL_CA_PATH=./certs/mysql-ca.pem

# PostgreSQL 직접 연결. DB_MODE=postgres일 때 사용합니다.
# MySQL -> PostgreSQL 마이그레이션 스크립트는 이 파일을 미리 수정하지 않아도 됩니다.
# `npm run migrate:mysql-to-postgres` 대화형 입력 또는 명령줄 옵션으로 접속 정보를 전달하세요.
# POSTGRES_URL=postgres://chikapo:change_me@192.168.0.20:5432/chzzk_card_trade_view
# POSTGRES_HOST=192.168.0.20
# POSTGRES_PORT=5432
# POSTGRES_USER=chikapo
# POSTGRES_PASSWORD=change_me
# POSTGRES_DATABASE=chzzk_card_trade_view
# POSTGRES_SSL=false
# POSTGRES_CONNECTION_LIMIT=3
# POSTGRES_FALLBACK_CONNECTION_LIMIT_MAX=3

# SQLite fallback/로컬 운영용. DB_MODE=sqlite일 때 사용합니다.
SQLITE_DB_PATH=./local.sqlite
SQLITE_REQUIRE_PERSISTENT_PATH=false

# Supabase는 현재 운영 기본값이 아닙니다. DB_MODE=supabase일 때만 설정하세요.
# SUPABASE_URL=https://your-supabase-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_or_legacy_service_role_key_here
# SUPABASE_FETCH_TIMEOUT_MS=15000

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
UPLOADS_DIR=./public/uploads
STREAMER_IMAGE_MAX_UPLOAD_BYTES=20mb
CHAT_IMAGE_MAX_UPLOAD_BYTES=25mb
# GIF 채팅 첨부를 WebM으로 변환할 때 사용합니다. 비워두면 PATH의 ffmpeg를 사용합니다.
# FFMPEG_PATH=/usr/bin/ffmpeg
# 채팅 이미지 변환 동시성 제한입니다. GIF는 ffmpeg CPU 부담이 커서 1을 권장합니다.
CHAT_IMAGE_CONCURRENCY=2
CHAT_GIF_CONCURRENCY=1
CHAT_GIF_MAX_UPLOAD_BYTES=25mb
# 정적/GIF 변환 큐 전체가 동시에 보유할 수 있는 작업 수와 입력 버퍼 총량입니다.
CHAT_IMAGE_MAX_PENDING_JOBS=16
CHAT_IMAGE_MAX_PENDING_BYTES=64mb
# 압축된 입력 바이트와 별개로 Sharp가 디코딩할 전체 픽셀/애니메이션 프레임 하드 예산입니다.
CHAT_IMAGE_MAX_INPUT_PIXELS=40000000
CHAT_GIF_MAX_PAGES=300
# GIF -> WebM 변환 부하/속도 조정값입니다. 기본은 채팅용 빠른 VP8 인코딩입니다.
# CHAT_GIF_CODEC=vp8      # vp8: 빠름/낮은 CPU, vp9: 더 작은 파일/느림
# CHAT_GIF_FPS=18         # 낮출수록 빠르고 가벼움, GIF 느낌은 15~20 권장
# CHAT_GIF_CRF=34         # 높을수록 용량/부하 감소, 화질 감소
# CHAT_GIF_CPU_USED=5     # 높을수록 빠름, 0~8
# CHAT_GIF_THREADS=1      # 백엔드 CPU 보호 목적. 여유 있으면 2
# CHAT_GIF_TIMEOUT_MS=45000

# -----------------------------------------------------------------------------
# Chzzk OAuth / OpenAPI
# -----------------------------------------------------------------------------
CHZZK_CLIENT_ID=your_chzzk_client_id
CHZZK_CLIENT_SECRET=your_chzzk_client_secret
# 치지직 프로필/live-status 요청 제한 시간(응답 본문 파싱 포함)
CHZZK_FETCH_TIMEOUT_MS=10000
CHZZK_API_URL=https://api.chzzk.naver.com
# 유저가 특정 치지직 채널을 구독 중인지 확인합니다.
# 치지직 공식 /open/v1/channels/subscribers API를 사용하므로 구독 대상 broadcaster_channel_id 계정이
# 이 사이트에 로그인되어 있어야 하며, 해당 치지직 앱에 "채널 구독자 조회" 권한이 필요합니다.
CHZZK_SUBSCRIPTION_CHECK_TTL_HOURS=6
CHZZK_SUBSCRIBER_LIST_CACHE_SECONDS=600
CHZZK_SUBSCRIBER_LIST_CACHE_MAX_ENTRIES=50
CHZZK_SUBSCRIBER_LIST_MAX_PAGES=200

# -----------------------------------------------------------------------------
# Web push
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@yuaru.com
PUSH_SEND_BATCH_SIZE=25
PUSH_SEND_BATCH_DELAY_MS=200
# web-push가 응답 없는 푸시 엔드포인트의 소켓을 종료할 제한 시간입니다(1~60초로 보정).
PUSH_SEND_TIMEOUT_MS=10000
# 개별 사용자 푸시는 DB 조회 전부터 중앙 큐로 제한합니다(코드 hard cap: 16/256/4).
PUSH_USER_DELIVERY_MAX_CONCURRENT=4
PUSH_USER_DELIVERY_MAX_QUEUED=64
PUSH_USER_DELIVERY_MAX_PENDING_PER_USER=2

# -----------------------------------------------------------------------------
# Site insights
# -----------------------------------------------------------------------------
# 자체 인사이트 수집/집계 기능입니다. 원시 이벤트는 제한 보관하고 시간별 롤업은 누적합니다.
SITE_INSIGHTS_ENABLED=true
SITE_INSIGHTS_CACHE_TTL_MS=30000
SITE_INSIGHTS_EVENT_RETENTION_DAYS=120
SITE_INSIGHTS_CLEANUP_INTERVAL_MS=21600000
SITE_INSIGHTS_FLUSH_INTERVAL_MS=2000
SITE_INSIGHTS_MAX_QUEUE_SIZE=5000

# -----------------------------------------------------------------------------
# Process-role controls
# -----------------------------------------------------------------------------
# API 프로세스에서는 이미지 프록시를 끄고 image-worker로 라우팅하는 것을 권장합니다.
API_SERVE_IMAGE_PROXY=false

# api 역할에서는 기본적으로 false입니다. scheduler-worker에서 true로 override하세요.
RUN_PUSH_SCHEDULER=false
RUN_MARKET_SCHEDULER=false

# -----------------------------------------------------------------------------
# Live status / external chat counter
# -----------------------------------------------------------------------------
CHAT_COUNT_FLUSH_INTERVAL_MS=10000
CHAT_COUNT_FLUSH_WARN_THRESHOLD=10000
CHAT_CONNECT_TIMEOUT_MS=5000
CHAT_CONNECT_BACKOFF_BASE_MS=300000
CHAT_CONNECT_BACKOFF_MAX_MS=1800000
MYSQL_CHAT_FLUSH_CHUNK_SIZE=50

OFFLINE_POLL_SHARDS=10
# 전체 프로필 폴링 사이 방송 시작 감지용 경량 live-status 샤드(2 = 최대 약 4분)
OFFLINE_LIVE_PROBE_SHARDS=2
OFFLINE_COMPUTE_EVERY_CYCLES=10
VALUE_HISTORY_RECORD_EVERY_CYCLES=10
VALUE_HISTORY_MIN_PCT_DELTA=0.005
VALUE_HISTORY_RETENTION_DAYS=7
VALUE_HISTORY_PRUNE_EVERY_CYCLES=30
VALUE_HISTORY_PRUNE_CHUNK_SIZE=10000
VALUE_HISTORY_PRUNE_MAX_CHUNKS=50
STREAMER_SCHEDULE_UPDATE_CHUNK_SIZE=80
VALUE_HISTORY_INSERT_CHUNK_SIZE=100
VALUE_HISTORY_INSERT_CHUNK_DELAY_MS=30
VALUE_AGO_CACHE_TTL_MS=300000
VALUE_AGO_LOOKBACK_HOURS=3
VALUE_AGO_CHANNEL_QUERY_THRESHOLD=200
VALUE_AGO_CHANNEL_CHUNK_SIZE=200

# -----------------------------------------------------------------------------
# Market / ranking / profile cache
# -----------------------------------------------------------------------------
MARKET_LIST_CACHE_TTL_MS=5000
MARKET_SETTLE_MIN_INTERVAL_MS=15000
MARKET_STALE_LISTING_DAYS=7
MARKET_STALE_CANCEL_BATCH=200
STREAMER_RANKING_MAX_LIMIT=10000
STREAMER_RANKING_CHANGE_HISTORY_ENABLED=true
STREAMERS_INCLUDE_VALUE_1H_HISTORY=true
STREAMER_RANKING_TITLES_CACHE_TTL_MS=300000
STREAMER_DETAIL_CACHE_TTL_MS=30000
STREAMER_DETAIL_STALE_TTL_MS=300000
# /api/streamers/live-status 프로세스 내부 캐시(10~15초 범위로 보정됨)
LIVE_STATUS_CACHE_TTL_MS=12000
RANKINGS_CACHE_TTL_MS=120000
USER_RANKING_ALLOW_LIVE_FALLBACK=false
USER_RANKING_SNAPSHOT_REFRESH_IN_API=false
USER_RANKING_SNAPSHOT_SCHEDULER_ENABLED=false
USER_RANKING_SNAPSHOT_TTL_MS=900000
USER_RANKING_SNAPSHOT_MIN_REFRESH_INTERVAL_MS=600000
USER_RANKING_SNAPSHOT_SCHEDULER_INTERVAL_MS=900000
USER_RANKING_SNAPSHOT_STATEMENT_TIMEOUT_MS=45000
USER_RANKING_SNAPSHOT_PRESENCE_CACHE_TTL_MS=10000
PROFILE_SYNC_THROTTLE_MS=600000
PROFILE_SYNC_CACHE_RETENTION_MS=86400000
DRAW_POOL_CACHE_TTL_MS=60000
SYSTEM_CONFIG_CACHE_TTL_MS=30000
MINIGAME_TERMINAL_SUCCESS_RETRY_GRACE_MS=60000

# -----------------------------------------------------------------------------
# Image proxy worker
# -----------------------------------------------------------------------------
IMAGE_WORKER_PORT=2087
IMAGE_PROXY_TIMEOUT_MS=3000
IMAGE_PROXY_CACHE_TTL_MS=86400000
IMAGE_PROXY_NEGATIVE_CACHE_TTL_MS=300000
IMAGE_PROXY_MAX_BYTES=4194304
IMAGE_PROXY_MAX_CACHE_BYTES=16777216
IMAGE_PROXY_MAX_CACHE_ENTRIES=150
IMAGE_PROXY_MAX_CACHE_ENTRY_BYTES=524288
IMAGE_PROXY_MAX_RESIZE_WIDTH=768
IMAGE_PROXY_PSTATIC_TYPES=f60_60_na,f120_120_na,f240_240_na
# 서로 다른 캐시 키에 대해 동시에 수행할 최대 원격 이미지 요청 수입니다(최대 256).
IMAGE_PROXY_MAX_IN_FLIGHT=32
# Sharp 래스터 디코드 동시 실행 수(최대 8)와 이미지당 픽셀 상한(최대 24000000)입니다.
IMAGE_PROXY_MAX_TRANSFORMS=4
IMAGE_PROXY_MAX_INPUT_PIXELS=16000000

# -----------------------------------------------------------------------------
# MySQL -> SQLite backup worker
# -----------------------------------------------------------------------------
MYSQL_SQLITE_BACKUP_ENABLED=true
POSTGRES_SQLITE_BACKUP_ENABLED=false
MYSQL_SQLITE_BACKUP_INCLUDE_VALUE_HISTORY=false
MYSQL_SQLITE_BACKUP_DIR=./backups/mysql-sqlite
MYSQL_SQLITE_BACKUP_RETENTION_DAYS=1
MYSQL_SQLITE_BACKUP_CRON=*/30 * * * *
MYSQL_SQLITE_BACKUP_BATCH_SIZE=500
MYSQL_SQLITE_BACKUP_MIN_UPTIME_SECONDS=300
MYSQL_SQLITE_BACKUP_MAX_RSS_MB=700
MYSQL_SQLITE_BACKUP_MAX_HEAP_USED_MB=450
MYSQL_SQLITE_BACKUP_MAX_REALTIME_CLIENTS=20
MYSQL_SQLITE_BACKUP_MAX_NOTIFICATION_CLIENTS=20
MYSQL_SQLITE_BACKUP_MAX_CHAT_CONNECTIONS=10
MYSQL_SQLITE_BACKUP_MAX_DESIRED_CHAT_CONNECTIONS=10
MYSQL_SQLITE_BACKUP_MAX_CHAT_PENDING=200
MYSQL_SQLITE_BACKUP_MAX_RECONNECT_TIMERS=30
LINK_PREVIEW_MEMORY_CACHE_MAX_ENTRIES=1000
MYSQL_SQLITE_BACKUP_KEEP_COUNT=1
