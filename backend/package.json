{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/server.ts",
    "start:api": "PROCESS_ROLE=api ts-node src/server.ts",
    "start:all": "PROCESS_ROLE=all ts-node src/server.ts",
    "start:worker:live": "PROCESS_ROLE=live-worker ts-node src/workers/liveStatusWorker.ts",
    "start:worker:scheduler": "PROCESS_ROLE=scheduler-worker ts-node src/workers/schedulerWorker.ts",
    "start:worker:backup": "PROCESS_ROLE=backup-worker ts-node src/workers/backupWorker.ts",
    "start:worker:image": "PROCESS_ROLE=image-worker ts-node src/workers/imageProxyWorker.ts",
    "start:worker:chat": "ts-node src/workers/chatWorker.ts",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "migrate": "ts-node scripts/migrate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.43.4",
    "@types/web-push": "^3.6.4",
    "better-sqlite3": "^12.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fuse.js": "^7.4.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "mysql2": "^3.11.5",
    "node-cron": "^3.0.3",
    "postgres": "^3.4.4",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.14.2",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.8"
  }
}
