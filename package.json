{
  "name": "chikapo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "start:backend": "npm run start --workspace=backend",
    "start:backend:api": "npm run start:api --workspace=backend",
    "start:worker:live": "npm run start:worker:live --workspace=backend",
    "start:worker:scheduler": "npm run start:worker:scheduler --workspace=backend",
    "start:worker:backup": "npm run start:worker:backup --workspace=backend",
    "start:worker:image": "npm run start:worker:image --workspace=backend",
    "start:worker:chat": "npm run start:worker:chat --workspace=backend",
    "start:worker:arena": "npm run start:worker:arena --workspace=backend",
    "deploy:backend": "npm run build:backend && npm run start:backend",
    "migrate:backend": "npm run migrate --workspace=backend",
    "migrate:sqlite-to-mysql": "node scripts/sqlite-to-mysql.js",
    "migrate:mysql-to-postgres": "node scripts/mysql-to-postgres.js",
    "postgres:tune": "node scripts/postgres-tune.js",
    "arena:readiness": "node scripts/arena-service-readiness.mjs",
    "arena:balance": "npm run arena:balance --workspace=backend"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  },
  "overrides": {
    "body-parser": "1.20.6",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "pnpm": {
    "overrides": {
      "body-parser": "1.20.6",
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  }
}
