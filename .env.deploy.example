# deploy.sh environment example
#
# 운영 서버에서 이 파일을 .env.deploy 로 복사한 뒤 서버 환경에 맞게 수정하세요.
# deploy.sh는 .env -> backend/.env -> .env.deploy 순서로 값을 읽습니다.
# 따라서 .env.deploy 값은 배포 단계에서만 필요한 override로 사용하기 좋습니다.

# -----------------------------------------------------------------------------
# Deploy paths / process names
# -----------------------------------------------------------------------------
PROJECT_DIR=/home/ubuntu/ChzzkCardTradeView
API_APP_NAME=chikapo-api
WORKER_APP_NAMES=chikapo-live-worker chikapo-scheduler-worker chikapo-backup-worker chikapo-image-worker chikapo-chat-worker
KEEP_RELEASES=5

# -----------------------------------------------------------------------------
# Node / PM2
# -----------------------------------------------------------------------------
# pnpm 10은 Node.js 22 이상을 권장합니다.
REQUIRED_NODE_MAJOR=22

# SSH 비대화형 쉘에서 Node 18이 먼저 잡히면 아래 값을 실제 Node 22 경로로 지정하세요.
# 예: /home/ubuntu/.nvm/versions/node/v22.16.0/bin/node
# NODE_BIN=/home/ubuntu/.nvm/versions/node/v22.x.x/bin/node

# PM2가 PATH에서 안 잡히면 실제 pm2 경로를 지정하세요.
# 예: /home/ubuntu/.nvm/versions/node/v22.16.0/bin/pm2
# PM2_BIN=/home/ubuntu/.nvm/versions/node/v22.x.x/bin/pm2

# -----------------------------------------------------------------------------
# Backend health check
# -----------------------------------------------------------------------------
# backend/.env의 PORT/USE_HTTPS를 그대로 쓰는 경우 비워둬도 됩니다.
PORT=2083
USE_HTTPS=true

# Nginx 뒤의 로컬 HTTP 포트로 검사하고 싶다면 명시하세요.
# HEALTHCHECK_URL=http://127.0.0.1:5000/health

# -----------------------------------------------------------------------------
# Friend chat worker health check
# -----------------------------------------------------------------------------
CHAT_WORKER_PORT=5001
# CHAT_HEALTHCHECK_URL=http://127.0.0.1:5001/health

# -----------------------------------------------------------------------------
# MySQL backup / schema migration
# -----------------------------------------------------------------------------
# deploy.sh는 배포 전 mysqldump 백업을 만들고, 배포 후 init-db-mysql.sql을 적용합니다.
# 운영 DB 정보는 backend/.env에 이미 있다면 여기서 생략해도 됩니다.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=chikapo
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=chikapo

# 백업 또는 스키마 적용을 임시로 건너뛰어야 할 때만 true로 바꾸세요.
SKIP_DB_BACKUP=false
SKIP_SCHEMA=false
