# 치카포 프론트엔드 환경 변수 예시 설정
#
# 보안 원칙:
# - 프론트엔드는 Supabase에 직접 연결하지 않습니다.
# - 모든 DB 접근은 백엔드 API를 통해서만 수행합니다.
# - NEXT_PUBLIC_SUPABASE_* 값은 브라우저 번들에 노출되므로 추가하지 마세요.

# 사이트 공개 주소. sitemap/JSON-LD metadata에 사용됩니다.
NEXT_PUBLIC_SITE_URL=https://chikapo.yuaru.com

# 백엔드 API 연동 Base URL.
# 운영/Cloudflare Pages/Vercel dev 모두 백엔드 직통 주소를 사용합니다.
NEXT_PUBLIC_API_URL=https://api.yuaru.com/api

# 친구 1:1 톡 WebSocket URL.
# Cloudflare Pages 운영 환경에서는 명시적으로 설정하는 것을 권장합니다.
NEXT_PUBLIC_CHAT_WS_URL=wss://api.yuaru.com/chat

# 사이트 인사이트/분석.
# 자체 백엔드 API로 페이지뷰/체류/기능 이용 이벤트를 전송합니다.
# 자동 클릭/폼 캡처와 세션 리플레이는 없습니다.
NEXT_PUBLIC_ANALYTICS_ENABLED=true
# 활성 접속 추정용 heartbeat 주기입니다. 최소 30000ms, 권장 60000ms.
NEXT_PUBLIC_ANALYTICS_HEARTBEAT_MS=60000

# Cloudflare Pages 정적 export 빌드에서만 설정하세요.
# DEPLOY_TARGET=cloudflare-pages
